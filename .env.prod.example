# Copy to .env.prod and fill real values before ./scripts/docker/start.sh
#   cp .env.prod.example .env.prod

NODE_ENV=production
PORT=3000

# Public HTTPS origin (required in production — used for canonical, OG, sitemap, schema)
SITE_URL=https://gargindustrialmesh.com

# Session signing secret (required in production — min 32 characters)
SESSION_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Admin bootstrap / rotate password (min 8 chars). Rotates known published defaults on boot.
ADMIN_PASSWORD=change-me-strong-password

# Trust X-Forwarded-* from reverse proxy (Nginx/Caddy/etc.)
TRUST_PROXY=1

# Verbose request/boot logging + error stacks (docker-compose currently forces DEBUG=1)
DEBUG=0

# Optional
GST_NUMBER=
GA_MEASUREMENT_ID=
