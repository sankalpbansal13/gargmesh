<% const meta_description = "About Garg Industrial Mesh — trusted manufacturer and supplier of SS, GI and MS wire mesh, perforated sheets and safety spikes in Noida, serving Delhi NCR. Genuine grades, wholesale prices."; %>
<%- include('partials/_head', { meta_description: meta_description }) %>
<%- include('partials/_header') %>

<section class="page-head">
  <div class="container">
    <span class="eyebrow">About us</span>
    <h1>About Garg Industrial Mesh</h1>
    <p>Manufacturer and supplier of industrial wire mesh, perforated sheets and safety spikes from Sector 9, Noida — serving Delhi NCR.</p>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="section-head reveal" style="text-align:left;margin:0 0 1.25rem">
      <span class="eyebrow">Our story</span>
      <h2>Genuine grades. Direct prices.</h2>
    </div>
    <p>Garg Industrial Mesh supplies SS, GI and MS wire mesh and perforated sheets at manufacturer-direct rates. From G-25, G Block, Sector 9, Noida, we serve contractors, builders, factories and architects across Noida, Greater Noida, Delhi, Ghaziabad, Faridabad and Gurugram.</p>
    <p>Buyers come to us for three things: <strong>honest grades</strong> (SS 201/304, GI, MS), <strong>wholesale pricing</strong>, and <strong>same-day dispatch</strong> for in-stock items — whether one cut sheet or a bulk project order.</p>
    <figure class="about-photo reveal">
      <img src="/gallery-ss-welded.jpg" alt="SS welded mesh stock at Garg Industrial Mesh, Sector 9 Noida" loading="lazy" width="760" height="1013">
      <figcaption>Stock at Sector 9, Noida warehouse</figcaption>
    </figure>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Why us</span>
      <h2>What you can count on</h2>
    </div>
    <div class="why-list reveal-stagger">
      <div class="why-item"><h3>Genuine grades</h3><p>Real SS 201/304, GI and MS — no grade substitution.</p></div>
      <div class="why-item"><h3>Cut to size</h3><p>Sheets and rolls prepared to your exact dimensions.</p></div>
      <div class="why-item"><h3>Honest pricing</h3><p>Transparent wholesale rates with GST invoices.</p></div>
      <div class="why-item"><h3>NCR delivery</h3><p>Same-day dispatch option across Delhi NCR.</p></div>
    </div>
    <ul class="trust-list reveal" style="margin-top:1.5rem">
      <li><%- include('partials/_icon', {name:'shield-check', size:20}) %>GST Verified business<% if (site.gstLabel) { %> — <%= site.gstLabel %><% } %></li>
      <li><%- include('partials/_icon', {name:'layers', size:20}) %>Full grade range — SS, GI, MS, PVC, Aluminium, HDPE</li>
      <li><%- include('partials/_icon', {name:'package', size:20}) %>Custom cutting and bulk supply for projects</li>
    </ul>
  </div>
</section>

<section class="final-cta">
  <div class="container final-inner">
    <div class="final-text reveal">
      <span class="eyebrow">Let's talk</span>
      <h2>Tell us your requirement</h2>
      <p>Call or WhatsApp — we share price &amp; availability within minutes.</p>
      <div class="final-contact">
        <a href="tel:<%= site.phone %>" class="btn btn-amber"><%- include('partials/_icon', {name:'phone', size:18}) %> Call <%= site.phone %></a>
        <a href="https://wa.me/<%= site.whatsapp %>" class="btn btn-ghost" target="_blank" rel="noopener"><%- include('partials/_icon', {name:'whatsapp', size:16}) %> WhatsApp</a>
      </div>
    </div>
    <form class="quote-form reveal" action="/enquiry" method="POST">
      <input type="hidden" name="redirect" value="/about?sent=1">
      <%- include('partials/_enquiry_guard', { hpId: 'about' }) %>
      <span class="eyebrow">Request quote</span>
      <h3>Send your requirement</h3>
      <label>Name<input type="text" name="name" required autocomplete="name"></label>
      <label>Phone<input type="tel" name="phone" required inputmode="tel" autocomplete="tel"></label>
      <label>Details<textarea name="message" placeholder="Your requirement…" rows="3"></textarea></label>
      <button type="submit" class="btn btn-amber btn-block" data-ga="enquiry_submit">Send enquiry</button>
      <% if (typeof sent !== 'undefined' && sent) { %><p class="form-success">Thank you! We will contact you shortly.</p><% } %>
    </form>
  </div>
</section>

<%- include('partials/_stickybar') %>
<%- include('partials/_footer') %>
