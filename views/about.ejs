<% const meta_description = "About Garg Industrial Mesh — trusted manufacturer and supplier of SS, GI and MS wire mesh, perforated sheets and safety spikes in Noida, serving Delhi NCR. Genuine grades, wholesale prices."; %>
<%- include('partials/_head', { meta_description: meta_description }) %>
<%- include('partials/_header') %>

<section class="page-head">
  <div class="container">
    <span class="eyebrow">About us</span>
    <h1>About Garg Industrial Mesh</h1>
    <p>A trusted manufacturer and supplier of industrial wire mesh, perforated sheets and safety spikes based in Noida, serving the entire Delhi NCR.</p>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="section-head reveal" style="text-align:left;margin:0 0 var(--sp-5)">
      <span class="eyebrow">Our story</span>
      <h2>Manufacturing trust, one sheet at a time</h2>
    </div>
    <p>Garg Industrial Mesh was founded to supply genuine-grade wire mesh and perforated sheets at honest, manufacturer-direct prices. From our base at G-25, G Block, Sector 9, Noida, we serve contractors, builders, factories, farms, architects and homeowners across Noida, Greater Noida, Delhi, Ghaziabad, Faridabad and Gurugram.</p>
    <p>Over the years we have built a reputation for three things: <strong>genuine material grades</strong> (SS 201/304, GI, MS), <strong>fair wholesale pricing</strong>, and <strong>same-day dispatch</strong> for in-stock items. Whether you need a single sheet cut to size or a bulk order for a construction project, we treat every order with the same urgency.</p>
    <figure class="about-photo reveal">
      <img src="/gallery-ss-welded.jpg" alt="SS welded mesh stock at Garg Industrial Mesh, Sector 9 Noida" loading="lazy" width="760" height="1013">
      <figcaption>Construction net stock — Sector 9, Noida warehouse</figcaption>
    </figure>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">E-E-A-T</span>
      <h2>Why buyers across Delhi NCR trust us</h2>
      <p class="section-sub">Our credentials, spelled out plainly — the same signals search engines and AI assistants look for when recommending a supplier.</p>
    </div>
    <div class="why-grid reveal-stagger">
      <div class="why-item"><span class="why-ico"><%- include('partials/_icon', {name:'award', size:26}) %></span><h3>Experience</h3><p>Years of hands-on supply to contractors, builders, factories, farms and architects across Noida, Greater Noida and the wider Delhi NCR — real project track record, not a listing.</p></div>
      <div class="why-item"><span class="why-ico"><%- include('partials/_icon', {name:'shield-check', size:26}) %></span><h3>Expertise</h3><p>Deep product knowledge across SS 201/304/316, GI, MS, PVC, aluminium and HDPE — we specify the right grade, opening and gauge for your application, not just sell a sheet.</p></div>
      <div class="why-item"><span class="why-ico"><%- include('partials/_icon', {name:'layers', size:26}) %></span><h3>Authoritativeness</h3><p>A single-source stockist for the full mesh and perforated sheet range at G-25, G Block, Sector 9, Noida — published buyer guides on grades, sizes, IS standards and pricing.</p></div>
      <div class="why-item"><span class="why-ico"><%- include('partials/_icon', {name:'tag', size:26}) %></span><h3>Trustworthiness</h3><p>Grade-honest quoting (real SS 304 vs SS 201), proper GST invoices for input-credit, transparent wholesale rates and same-day dispatch — no substitution, no surprises.</p></div>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Our promise</span>
      <h2>What you can count on</h2>
    </div>
    <div class="why-grid reveal-stagger">
      <div class="why-item"><span class="why-ico"><%- include('partials/_icon', {name:'shield-check', size:26}) %></span><h3>Genuine Grades</h3><p>Real SS 201/304, GI and MS — no grade substitution.</p></div>
      <div class="why-item"><span class="why-ico"><%- include('partials/_icon', {name:'ruler', size:26}) %></span><h3>Cut to Size</h3><p>Sheets and rolls cut to your exact project dimensions.</p></div>
      <div class="why-item"><span class="why-ico"><%- include('partials/_icon', {name:'tag', size:26}) %></span><h3>Honest Pricing</h3><p>Transparent wholesale rates with no hidden charges.</p></div>
      <div class="why-item"><span class="why-ico"><%- include('partials/_icon', {name:'truck', size:26}) %></span><h3>Reliable Delivery</h3><p>Pan-NCR delivery with same-day dispatch option.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="section-head reveal" style="text-align:left;margin:0 0 var(--sp-5)">
      <span class="eyebrow">Credentials</span>
      <h2>Trust &amp; Credentials</h2>
    </div>
    <ul class="trust-list reveal-stagger">
      <li><%- include('partials/_icon', {name:'shield-check', size:20}) %>GST Verified business<% if (site.gstLabel) { %> — <%= site.gstLabel %><% } %></li>
      <li><%- include('partials/_icon', {name:'users', size:20}) %>Established supplier to builders, factories and architects across Delhi NCR</li>
      <li><%- include('partials/_icon', {name:'layers', size:20}) %>Full grade range — SS 201/304, GI, MS, PVC, Aluminium, HDPE</li>
      <li><%- include('partials/_icon', {name:'package', size:20}) %>Custom cutting and bulk supply for projects</li>
      <li><%- include('partials/_icon', {name:'zap', size:20}) %>Same-day dispatch for in-stock items</li>
    </ul>
  </div>
</section>

<section class="final-cta">
  <div class="container final-inner">
    <div class="final-text reveal">
      <span class="eyebrow">Let's talk</span>
      <h2>Let's Talk About Your Requirement</h2>
      <p>Call or WhatsApp us — we will share price &amp; availability within minutes.</p>
      <div class="final-contact">
        <a href="tel:<%= site.phone %>" class="btn btn-orange"><%- include('partials/_icon', {name:'phone', size:18}) %> Call <%= site.phone %></a>
        <a href="https://wa.me/<%= site.whatsapp %>" class="link-wa link-wa-light" target="_blank" rel="noopener"><%- include('partials/_icon', {name:'whatsapp', size:16}) %> WhatsApp</a>
      </div>
    </div>
    <form class="quote-form reveal" action="/enquiry" method="POST">
      <input type="hidden" name="redirect" value="/about?sent=1">
      <%- include('partials/_enquiry_guard', { hpId: 'about' }) %>
      <span class="eyebrow">Request Quote</span>
      <h3>Send Your Requirement</h3>
      <input type="text" name="name" placeholder="Your name" required>
      <input type="tel" name="phone" placeholder="Phone number" required>
      <textarea name="message" placeholder="Your requirement..." rows="3"></textarea>
      <button type="submit" class="btn btn-orange btn-block" data-ga="enquiry_submit">Send Enquiry</button>
      <% if (typeof sent !== 'undefined' && sent) { %><p class="form-success">Thank you! We will contact you shortly.</p><% } %>
    </form>
  </div>
</section>

<%- include('partials/_stickybar') %>
<%- include('partials/_footer') %>
