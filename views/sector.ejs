<%- include('partials/_head', { meta_description: meta_description, extraLd: extraLd }) %>
<%- include('partials/_header') %>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <div class="container">
    <a href="/">Home</a> ›
    <a href="/areas">Areas We Serve</a> ›
    <a href="/areas/<%= sector.citySlug %>"><%= sector.city %></a> ›
    <span><%= sector.locality || sector.sector %></span>
  </div>
</nav>

<section class="page-head">
  <div class="container">
    <span class="eyebrow"><%= sector.locality || sector.sector %>, <%= sector.city %></span>
    <h1><%= sector.title %></h1>
    <p><%= sector.intro %></p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">In stock</span>
      <h2>Mesh &amp; Fencing Available for <%= sector.locality || sector.sector %></h2>
    </div>
    <div class="product-grid reveal-stagger">
      <% products.forEach(function(p){ %>
        <%- include('partials/_productcard', {product: p}) %>
      <% }); %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <div class="section-head reveal" style="text-align:left;margin:0 0 var(--sp-5)">
      <span class="eyebrow">Where we deliver</span>
      <h2>Within <%= sector.locality || sector.sector %></h2>
    </div>
    <p><%= sector.zones %></p>
    <% if (sector.delivery) { %>
    <h3 class="post-h2" style="margin-top:var(--sp-5)">Delivery to <%= sector.locality || sector.sector %></h3>
    <p><%= sector.delivery %></p>
    <% } else { %>
    <p style="margin-top:var(--sp-4)">Same-day dispatch to <%= sector.locality || sector.sector %> for in-stock items. Call <a href="tel:<%= site.phone %>"><%= site.phone %></a> or WhatsApp us for price &amp; availability.</p>
    <% } %>
    <p style="margin-top:var(--sp-4)">Call <a href="tel:<%= site.phone %>"><%= site.phone %></a> or WhatsApp us for price &amp; availability. Browse the <a href="/areas/<%= sector.citySlug %>"><%= sector.city %> city page</a> or <a href="/products">full product range</a>.</p>
  </div>
</section>

<% if (related && related.length) { %>
<section class="section alt">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Nearby</span>
      <h2>Related Localities</h2>
      <p class="section-sub">Also serving nearby areas across <%= sector.city %> and Delhi NCR.</p>
    </div>
    <div class="areas-grid reveal-stagger">
      <% related.forEach(function(r){ %>
      <a href="/sectors/<%= r.slug %>" class="area-card">
        <span class="area-ico"><%- include('partials/_icon', {name:'map-pin', size:24}) %></span>
        <strong><%= r.locality || r.sector %></strong>
        <span class="area-sub">Wire mesh supplier in <%= r.locality || r.sector %>, <%= r.city %></span>
      </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="section<%= (related && related.length) ? '' : ' alt' %>">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2><%= sector.locality || sector.sector %> — Frequently Asked Questions</h2>
    </div>
    <div class="accordion reveal">
      <% sector.faq.forEach(function(f){ %>
      <div class="acc-item">
        <button class="acc-head" aria-expanded="false"><span><%= f.q %></span><span class="acc-sign" aria-hidden="true"><%- include('partials/_icon', {name:'chevron-down', size:16}) %></span></button>
        <div class="acc-body"><p><%= f.a %></p></div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="final-cta">
  <div class="container final-inner">
    <div class="final-text reveal">
      <span class="eyebrow">Get started</span>
      <h2>Need mesh in <%= sector.locality || sector.sector %>?</h2>
      <p>Get a free quote with price &amp; availability within minutes.</p>
      <div class="final-contact">
        <a href="tel:<%= site.phone %>" class="btn btn-amber" data-ga="call"><%- include('partials/_icon', {name:'phone', size:18}) %> Call <%= site.phone %></a>
        <a href="https://wa.me/<%= site.whatsapp %>?text=<%= encodeURIComponent('Hi Garg Industrial Mesh, I need wire mesh in '+(sector.locality||sector.sector)+', '+sector.city+'. Please share price & availability.') %>" class="btn btn-ghost" target="_blank" rel="noopener" data-ga="whatsapp"><%- include('partials/_icon', {name:'whatsapp', size:16}) %> WhatsApp</a>
      </div>
    </div>
    <form class="quote-form reveal" action="/enquiry" method="POST">
      <input type="hidden" name="redirect" value="/sectors/<%= sector.slug %>?sent=1">
      <input type="hidden" name="product" value="Enquiry from <%= sector.locality || sector.sector %>, <%= sector.city %> page">
      <%- include('partials/_enquiry_guard', { hpId: 'sector' }) %>
      <span class="eyebrow">Request quote</span>
      <h3>Send your requirement</h3>
      <label>Name<input type="text" name="name" required autocomplete="name"></label>
      <label>Phone<input type="tel" name="phone" required inputmode="tel" autocomplete="tel"></label>
      <label>Details<textarea name="message" placeholder="Product, grade, size, quantity…" rows="3"></textarea></label>
      <button type="submit" class="btn btn-amber btn-block" data-ga="enquiry_submit">Send enquiry</button>
      <% if (typeof sent !== 'undefined' && sent) { %><p class="form-success">Thank you! We will contact you shortly.</p><% } %>
    </form>
  </div>
</section>

<%- include('partials/_stickybar') %>
<%- include('partials/_footer') %>
