      <% industries.forEach(function(it){ %>
      <div class="ind-item">
        <span class="ind-ico"><%- include('partials/_icon', {name:it.icon, size:22}) %></span>
        <span><%= it.label %></span>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="section alt section-tight">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Our range</span>
