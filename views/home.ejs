  {icon:'leaf', label:'Agriculture & Farm'},
  {icon:'filter', label:'Filtration'},
  {icon:'grid', label:'Architecture'},
  {icon:'wind', label:'HVAC & Ventilation'},
  {icon:'bird', label:'Bird & Monkey Control'}
];
/* Icons: fence panel (shield), wheat/crop (leaf), sieve (filter), mesh grid (grid), fan (wind), bird+spikes (bird) */
const whys = [
  {icon:'tag', h:'Direct Manufacturer Prices', p:'Buy direct from the source — no middleman markup on bulk mesh orders.'},
  {icon:'zap', h:'Same-Day Dispatch', p:'In-stock items dispatched same day across Noida & Delhi NCR.'},
  {icon:'layers', h:'Full Grade Range', p:'SS 201/304, GI, MS — every grade, opening size and sheet dimension.'},
  {icon:'ruler', h:'Custom Cutting', p:'Sheets and rolls cut to your exact size for your project.'},
  {icon:'truck', h:'Pan-NCR Delivery', p:'Noida, Greater Noida, Delhi, Ghaziabad, Faridabad, Gurugram.'},
  {icon:'handshake', h:'Trusted Supplier', p:'Years of experience serving contractors, builders and factories.'}
];
