<% const jsonLd = localBusiness; %>
<% const extraLd = [faqLd, organization, website]; %>
<% const meta_description = "SS, GI, MS, copper, brass & aluminium wire mesh, perforated sheets & expanded mesh (barfi jali) supplier in Noida. Wholesale prices, same-day NCR delivery. Call 9910238277."; %>
<% const meta_keywords = "wire mesh noida, perforated sheet noida, expanded mesh noida, copper expanded mesh, brass expanded mesh, ms expanded mesh, barfi jali, copper perforated sheet, welded mesh supplier noida, garg industrial mesh"; %>
<%- include('partials/_head', { meta_description: meta_description, meta_keywords: meta_keywords, jsonLd: jsonLd, extraLd: extraLd }) %>
<%- include('partials/_header') %>

