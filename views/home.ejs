<%
const localBusiness = {
  "@context":"https://schema.org","@type":"HardwareStore",
  "name":"GARG INDUSTRIAL MESH","image":site.url+"/logo.png","telephone":"+91"+site.phone,
  "address":{"@type":"PostalAddress","streetAddress":"G-25, G Block, Sector 9","addressLocality":"Noida","addressRegion":"Uttar Pradesh","postalCode":"201301","addressCountry":"IN"},
  "url":site.url,"openingHours":"Mo-Sa 09:30-19:30","priceRange":"₹₹",
  "areaServed":["Noida","Greater Noida","Delhi","Ghaziabad","Faridabad","Gurugram"]
};
const organization = {"@context":"https://schema.org","@type":"Organization","name":"GARG INDUSTRIAL MESH","url":site.url,"logo":site.url+"/logo.png","telephone":"+91"+site.phone,"address":{"@type":"PostalAddress","streetAddress":"G-25, G Block, Sector 9","addressLocality":"Noida","addressRegion":"Uttar Pradesh","postalCode":"201301","addressCountry":"IN"}};
const website = {"@context":"https://schema.org","@type":"WebSite","name":"GARG INDUSTRIAL MESH","url":site.url,"potentialAction":{"@type":"SearchAction","target":site.url+"/products?q={search_term_string}","query-input":"required name=search_term_string"}};
const faqs = [
  {q:"Where are you located?", a:"G-25, G Block, Sector 9, Noida 201301. Walk-ins welcome during business hours."},
  {q:"Do you supply bulk project orders?", a:"Yes. SS, GI and MS welded mesh, perforated sheets and fencing in bulk across Delhi NCR. Call 9910238277 for wholesale pricing."},
  {q:"How fast is delivery in NCR?", a:"In-stock items dispatch same day. Delivery across Noida, Greater Noida, Delhi, Ghaziabad, Faridabad and Gurugram typically takes 1–2 days."},
  {q:"Can you cut mesh to size?", a:"Yes. Sheets and rolls are cut to your exact project dimensions."},
  {q:"Are you GST registered?", a:"Yes — GST Verified. We provide proper GST invoices with every order."}
];
const faqLd = {"@context":"https://schema.org","@type":"FAQPage","mainEntity":faqs.map(f=>({"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":f.a}}))};
const whys = [
  {h:'Direct prices', p:'Manufacturer rates — no middleman markup on bulk orders.'},
  {h:'Same-day dispatch', p:'In-stock grades leave our Sector 9 warehouse the same day.'},
  {h:'Cut to size', p:'Sheets and rolls prepared to your exact project dimensions.'},
  {h:'Pan-NCR delivery', p:'Noida, Greater Noida, Delhi, Ghaziabad, Faridabad, Gurugram.'}
];
const showProducts = (typeof featured !== 'undefined' && featured.length) ? featured.slice(0, 8) : products.slice(0, 8);
%>
<% const jsonLd = localBusiness; %>
<% const extraLd = [faqLd, organization, website]; %>
<% const meta_description = "SS, GI, MS, copper, brass & aluminium wire mesh, perforated sheets & expanded mesh supplier in Noida. Wholesale prices, same-day NCR delivery. Call 9910238277."; %>
<% const meta_keywords = "wire mesh noida, perforated sheet noida, expanded mesh noida, welded mesh supplier noida, garg industrial mesh"; %>
<%- include('partials/_head', { meta_description: meta_description, meta_keywords: meta_keywords, jsonLd: jsonLd, extraLd: extraLd }) %>
<%- include('partials/_header') %>

<section class="hero hero-reveal" id="heroBrand" aria-label="Garg Industrial Mesh"
  data-hero-slides='[{"src":"/hero-mesh.jpg","label":"Perforated sheets","blurb":"Precision punched holes in SS, GI & MS — for filtration, cladding and machine guards."},{"src":"/hero-welded.jpg","label":"Welded mesh","blurb":"Rigid square welded panels for fencing, cages and construction reinforcement."},{"src":"/hero-expanded.jpg","label":"Expanded mesh","blurb":"Diamond-cut expanded metal — strong, open and cut to your sheet size."},{"src":"/hero-chain-link.jpg","label":"Chain link","blurb":"Interlocking diamond fence fabric for sites, compounds and boundary walls."},{"src":"/hero-wire-mesh.jpg","label":"Wire mesh","blurb":"Fine woven wire cloth for screens, sieves and industrial filtration."},{"src":"/hero-bird-mesh.jpg","label":"Bird / protection mesh","blurb":"Anti-bird mesh that keeps façades and ledges clear without heavy framing."},{"src":"/hero-construction-net.jpg","label":"Construction net","blurb":"Safety debris netting for scaffolding and active construction sites."}]'>
  <div class="hero-media" aria-hidden="true">
    <img class="hero-layer hero-layer-outline" id="heroOutlineImg" src="/hero-mesh-outline.jpg" alt="" width="1920" height="1080" decoding="async" fetchpriority="high">
    <canvas class="hero-layer hero-layer-outline hero-layer-outline-canvas" id="heroMeshCanvas" width="1920" height="1080" hidden></canvas>
    <img class="hero-layer hero-layer-photo is-active" id="heroPhotoA" src="/hero-mesh.jpg" alt="" width="1920" height="1080" decoding="async" fetchpriority="high">
    <img class="hero-layer hero-layer-photo hero-layer-photo-next" id="heroPhotoB" src="/hero-welded.jpg" alt="" width="1920" height="1080" decoding="async">
    <div class="hero-vignette" aria-hidden="true"></div>
  </div>
  <button type="button" class="hero-nav hero-nav-prev" id="heroPrev" aria-label="Previous sheet type">
    <%- include('partials/_icon', {name:'chevron-left', size:22}) %>
  </button>
  <button type="button" class="hero-nav hero-nav-next" id="heroNext" aria-label="Next sheet type">
    <%- include('partials/_icon', {name:'chevron-right', size:22}) %>
  </button>
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="brand-mark">Garg Industrial Mesh</p>
      <h1 class="hero-headline">Industrial wire mesh &amp; perforated sheets</h1>
      <p class="hero-sub">Wholesale SS, GI &amp; MS from Sector 9, Noida — cut to size, delivered across Delhi NCR.</p>
      <div class="hero-cta">
        <a href="/contact" class="btn btn-amber" data-ga="quote">Get free quote</a>
        <a href="https://wa.me/<%= site.whatsapp %>?text=<%= encodeURIComponent('Hi Garg Industrial Mesh, I would like a quote.') %>" class="btn btn-ghost" target="_blank" rel="noopener" data-ga="whatsapp"><%- include('partials/_icon', {name:'whatsapp', size:16}) %> WhatsApp</a>
      </div>
    </div>
    <aside class="hero-card" id="heroCard" aria-live="polite">
      <p class="hero-card-type" id="heroType">Perforated sheets</p>
      <p class="hero-card-blurb" id="heroBlurb">Precision punched holes in SS, GI &amp; MS — for filtration, cladding and machine guards.</p>
      <div class="hero-dots" id="heroDots" role="tablist" aria-label="Sheet types"></div>
    </aside>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Catalogue</span>
      <h2>Featured products</h2>
      <p class="section-sub">Popular grades in stock — request a quote for wholesale pricing.</p>
    </div>
    <div class="product-grid reveal-stagger">
      <% showProducts.forEach(function(p){ %>
        <%- include('partials/_productcard', {product: p}) %>
      <% }); %>
    </div>
    <p style="margin-top:1.25rem" class="reveal">
      <a href="/products" class="btn btn-ghost">View all products</a>
    </p>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Why us</span>
      <h2>Built for contractors &amp; factories</h2>
    </div>
    <div class="why-list reveal-stagger">
      <% whys.forEach(function(w){ %>
      <div class="why-item">
        <h3><%= w.h %></h3>
        <p><%= w.p %></p>
      </div>
      <% }); %>
    </div>
    <div class="process reveal" style="margin-top:1.75rem">
      <div class="step"><span class="step-num">01</span><div><h3>Enquire</h3><p>Call, WhatsApp or send the form with grade &amp; size.</p></div></div>
      <div class="step"><span class="step-num">02</span><div><h3>Quote</h3><p>Price and availability within minutes.</p></div></div>
      <div class="step"><span class="step-num">03</span><div><h3>Deliver</h3><p>Cut, packed and dispatched across NCR.</p></div></div>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Coverage</span>
      <h2>Areas we serve</h2>
      <p class="section-sub">Same-day dispatch zones across Delhi NCR.</p>
    </div>
    <div class="areas-row reveal">
      <a href="/areas/noida" class="area-link">Noida</a>
      <a href="/areas/greater-noida" class="area-link">Greater Noida</a>
      <a href="/areas/delhi" class="area-link">Delhi</a>
      <a href="/areas/ghaziabad" class="area-link">Ghaziabad</a>
      <a href="/areas/faridabad" class="area-link">Faridabad</a>
      <a href="/areas/gurugram" class="area-link">Gurugram</a>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2>Common questions</h2>
    </div>
    <div class="accordion reveal">
      <% faqs.forEach(function(f){ %>
      <div class="acc-item">
        <button class="acc-head" aria-expanded="false"><span><%= f.q %></span><span class="acc-sign" aria-hidden="true"><%- include('partials/_icon', {name:'chevron-down', size:16}) %></span></button>
        <div class="acc-body"><p><%= f.a %></p></div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="final-cta">
  <div class="container final-inner">
    <div class="final-text reveal">
      <span class="eyebrow">Get started</span>
      <h2>Request a quote</h2>
      <p>Share grade, size and quantity — we reply with price &amp; availability quickly.</p>
      <div style="display:flex;flex-direction:column;gap:0.55rem;margin-top:1rem">
        <a href="tel:<%= site.phone %>" class="btn btn-amber" data-ga="call"><%- include('partials/_icon', {name:'phone', size:18}) %> <%= site.phone %></a>
        <a href="https://wa.me/<%= site.whatsapp %>" class="btn btn-ghost" target="_blank" rel="noopener" data-ga="whatsapp"><%- include('partials/_icon', {name:'whatsapp', size:16}) %> WhatsApp</a>
      </div>
    </div>
    <form class="quote-form reveal" action="/enquiry" method="POST">
      <input type="hidden" name="redirect" value="/?sent=1">
      <%- include('partials/_enquiry_guard', { hpId: 'home' }) %>
      <span class="eyebrow">Enquiry</span>
      <h3>Send your requirement</h3>
      <label>Name<input type="text" name="name" required autocomplete="name"></label>
      <label>Phone<input type="tel" name="phone" required inputmode="tel" autocomplete="tel"></label>
      <label>Product / requirement<input type="text" name="product" placeholder="e.g. SS 304 welded mesh"></label>
      <label>Details<textarea name="message" placeholder="Grade, size, quantity…" rows="3"></textarea></label>
      <button type="submit" class="btn btn-amber btn-block" data-ga="enquiry_submit">Send enquiry</button>
      <% if (typeof sent !== 'undefined' && sent) { %><p class="form-success">Thank you! We will contact you shortly.</p><% } %>
    </form>
  </div>
</section>

<%- include('partials/_stickybar') %>
<%- include('partials/_footer') %>
