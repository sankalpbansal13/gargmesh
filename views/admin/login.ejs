<%- include('_head') %>
<main class="admin-login-wrap">
  <form class="admin-login-card" action="/admin/login" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <a href="/" class="admin-logo">
      <img src="/logo.png" alt="Garg Industrial Mesh" width="56" height="56">
    </a>
    <h1>Admin login</h1>
    <p class="admin-sub">Garg Industrial Mesh</p>
    <% if (error) { %><p class="form-error"><%= error %></p><% } %>
    <label>Username
      <input type="text" name="username" required autofocus autocomplete="username">
    </label>
    <label>Password
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit" class="btn btn-amber btn-block">Login</button>
    <a href="/" class="admin-back">← Back to site</a>
  </form>
</main>
</body>
</html>
