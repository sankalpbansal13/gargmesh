<%- include('_head') %>
<%- include('_nav', { adminPage: 'dashboard' }) %>
<main class="admin-main">
  <h1>Dashboard</h1>
  <% if (typeof flash !== 'undefined' && flash) { %><p class="form-success"><%= flash %></p><% } %>
  <div class="admin-stats">
    <a href="/admin/products" class="admin-stat">
      <strong><%= productCount %></strong>
      <span>Products</span>
    </a>
    <a href="/admin/enquiries" class="admin-stat">
      <strong><%= enquiryCount %></strong>
      <span>Enquiries</span>
    </a>
    <a href="/admin/products/new" class="admin-stat admin-stat-cta">
      <strong>+</strong>
      <span>Add product</span>
    </a>
  </div>
  <section class="admin-card">
    <h2 style="margin-bottom:0.85rem;font-size:1.1rem">Recent enquiries</h2>
    <% if (recentEnquiries.length) { %>
    <div class="admin-list" style="display:grid">
      <% recentEnquiries.forEach(function(e){ %>
      <div class="admin-row">
        <div class="admin-row-title"><%= e.name %></div>
        <div class="admin-row-meta">
          <a href="tel:<%= e.phone %>"><%= e.phone %></a>
          <% if (e.product) { %> · <%= e.product %><% } %>
          · <%= e.created_at %>
        </div>
      </div>
      <% }); %>
    </div>
    <% } else { %><p class="empty-state">No enquiries yet.</p><% } %>
    <p style="margin-top:1rem"><a href="/admin/enquiries">View all enquiries →</a></p>
  </section>
</main>
<%- include('_foot') %>
