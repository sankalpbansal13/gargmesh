<%- include('_head') %>
<%- include('_nav', { adminPage: isEdit ? 'products' : 'product-new' }) %>
<main class="admin-main">
  <h1><%= isEdit ? 'Edit product' : 'Add product' %></h1>
  <% if (typeof flash !== 'undefined' && flash) { %><p class="form-success"><%= flash %></p><% } %>
  <form class="admin-form" action="<%= isEdit ? '/admin/products/'+product.id+'?_method=PUT' : '/admin/products' %>" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <label>Name *
        <input type="text" name="name" value="<%= product.name||'' %>" required>
      </label>
      <label>Category *
        <select name="category_id" required>
          <option value="">Choose a category</option>
          <% categories.forEach(function(c){ %>
          <option value="<%= c.id %>" <%= String(product.category_id)===String(c.id)?'selected':'' %>><%= c.name %></option>
          <% }); %>
        </select>
      </label>
      <label>Slug (URL)
        <input type="text" name="slug" value="<%= product.slug||'' %>" placeholder="auto-generated from name">
      </label>
      <label class="checkbox-label">
        <input type="checkbox" name="featured" value="1" <%= product.featured?'checked':'' %>> Featured
      </label>
    </div>
    <label>Short description
      <input type="text" name="short_desc" value="<%= product.short_desc||'' %>" placeholder="One line on the product card">
    </label>
    <label>Description
      <textarea name="description" rows="5"><%= product.description||'' %></textarea>
    </label>
    <label>Applications
      <input type="text" name="applications" value="<%= product.applications||'' %>">
    </label>

    <fieldset class="seo-fieldset">
      <legend>Materials and prices</legend>
      <p class="admin-hint">Each metal has its own price. Leave the price blank to show “Ask for quote” on the site.</p>
      <div id="matRows">
        <% (materials || []).forEach(function(m){ %>
        <div class="faq-row">
          <input type="hidden" name="mat_id" value="<%= m.id %>">
          <input type="text" name="mat_name" value="<%= m.name||'' %>" placeholder="Material" required>
          <input type="text" name="mat_grades" value="<%= m.grades||'' %>" placeholder="Grades">
          <input type="text" name="mat_short" value="<%= m.short_desc||'' %>" placeholder="Short note">
          <input type="text" name="mat_price" value="<%= m.price_from||'' %>" placeholder="Price, e.g. ₹120/sqft">
          <label class="checkbox-label"><input type="checkbox" name="mat_remove" value="<%= m.id %>"> Remove this material</label>
        </div>
        <% }); %>
      </div>
      <div id="newMats"></div>
      <button type="button" class="btn btn-ghost btn-sm" id="matAdd">Add material</button>
    </fieldset>

    <fieldset class="seo-fieldset">
      <legend>SEO meta</legend>
      <label>Meta title
        <input type="text" name="meta_title" value="<%= product.meta_title||'' %>">
      </label>
      <label>Meta description
        <textarea name="meta_description" rows="2"><%= product.meta_description||'' %></textarea>
      </label>
      <label>Meta keywords
        <input type="text" name="meta_keywords" value="<%= product.meta_keywords||'' %>">
      </label>
    </fieldset>

    <% let existingFaqs = []; try { existingFaqs = product.faq ? JSON.parse(product.faq) : []; } catch(e){ existingFaqs = []; } if (!existingFaqs.length) existingFaqs = [{q:'',a:''}]; %>
    <fieldset class="seo-fieldset faq-fieldset">
      <legend>FAQ</legend>
      <div id="faqRows">
        <% existingFaqs.forEach(function(f){ %>
        <div class="faq-row">
          <input type="text" name="faq_q" value="<%= f.q||'' %>" placeholder="Question">
          <textarea name="faq_a" rows="2" placeholder="Answer"><%= f.a||'' %></textarea>
          <button type="button" class="btn btn-danger btn-sm faq-remove">Remove</button>
        </div>
        <% }); %>
      </div>
      <button type="button" class="btn btn-ghost btn-sm" id="faqAdd">Add FAQ</button>
    </fieldset>

    <label>Photos (JPG, PNG, or WebP, max 3MB each)
      <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" multiple>
    </label>

    <div class="form-actions">
      <button type="submit" class="btn btn-amber"><%= isEdit ? 'Save product' : 'Create product' %></button>
      <a href="/admin/products" class="btn btn-ghost">Cancel</a>
      <% if (isEdit && product.category_slug && product.slug && !product.deleted) { %>
      <a href="/products/<%= product.category_slug %>/<%= product.slug %>" class="btn btn-ghost" target="_blank" rel="noopener">View live</a>
      <% } %>
    </div>
  </form>

  <% if (isEdit && images && images.length) { %>
  <div class="admin-images">
    <h2 style="font-size:1.15rem;margin:1.5rem 0 0.5rem">Current photos</h2>
    <p class="admin-hint">The cover is the photo on the product card. These actions save on their own.</p>
    <div class="admin-img-grid">
      <% images.forEach(function(img){ %>
      <div class="admin-img">
        <img src="/uploads/<%= img.filename %>" alt="<%= img.alt_text || product.name %>" loading="lazy">
        <% if (img.is_cover) { %><span class="cover-badge">Cover</span><% } %>
        <form action="/admin/images/<%= img.id %>" method="POST" class="img-meta-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="text" name="caption" value="<%= img.caption||'' %>" placeholder="Caption">
          <input type="text" name="alt_text" value="<%= img.alt_text||'' %>" placeholder="Alt text">
          <button type="submit" class="btn btn-ghost btn-sm">Save</button>
        </form>
        <div class="img-row-actions">
          <% if (!img.is_cover) { %>
          <form action="/admin/images/<%= img.id %>/cover" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-ghost btn-sm">Set cover</button>
          </form>
          <% } %>
          <form action="/admin/images/<%= img.id %>/move" method="POST" style="display:inline-flex;gap:4px">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" name="dir" value="up" class="btn btn-ghost btn-sm">Up</button>
            <button type="submit" name="dir" value="down" class="btn btn-ghost btn-sm">Down</button>
          </form>
          <form action="/admin/images/<%= img.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this photo?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
          </form>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
  <% } %>

  <script>
    (function () {
      var mats = document.getElementById('newMats');
      var matAdd = document.getElementById('matAdd');
      if (mats && matAdd) {
        matAdd.addEventListener('click', function () {
          var row = document.createElement('div');
          row.className = 'faq-row';
          row.innerHTML = '<input type="text" name="mat_new_name" placeholder="New material"><input type="text" name="mat_new_grades" placeholder="Grades"><input type="text" name="mat_new_price" placeholder="Price"><button type="button" class="btn btn-danger btn-sm">Remove</button>';
          row.querySelector('button').addEventListener('click', function () { row.remove(); });
          mats.appendChild(row);
        });
      }
      var wrap = document.getElementById('faqRows');
      var addBtn = document.getElementById('faqAdd');
      if (!wrap || !addBtn) return;
      function bindRemove() {
        wrap.querySelectorAll('.faq-remove').forEach(function (b) {
          if (b.dataset.bound) return;
          b.dataset.bound = '1';
          b.addEventListener('click', function () {
            if (wrap.querySelectorAll('.faq-row').length > 1) b.closest('.faq-row').remove();
          });
        });
      }
      addBtn.addEventListener('click', function () {
        var row = document.createElement('div');
        row.className = 'faq-row';
        row.innerHTML = '<input type="text" name="faq_q" placeholder="Question"><textarea name="faq_a" rows="2" placeholder="Answer"></textarea><button type="button" class="btn btn-danger btn-sm faq-remove">Remove</button>';
        wrap.appendChild(row);
        bindRemove();
      });
      bindRemove();
    })();
  </script>
</main>
<%- include('_foot') %>
