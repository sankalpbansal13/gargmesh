<%- include('_head') %>
<%- include('_nav', { adminPage: 'enquiries' }) %>
<main class="admin-main">
  <h1>Enquiries</h1>
  <% if (typeof flash !== 'undefined' && flash) { %><p class="form-success"><%= flash %></p><% } %>
  <div class="admin-toolbar">
    <a href="/admin/enquiries.csv" class="btn btn-ghost btn-sm">Export CSV</a>
    <a href="/admin/enquiries" class="btn btn-ghost btn-sm">All</a>
    <% statuses.forEach(function(s){ %>
    <a href="/admin/enquiries?status=<%= s %>" class="btn btn-ghost btn-sm"><%= s %></a>
    <% }); %>
  </div>
  <% if (enquiries.length) { %>
  <form id="bulkForm" action="/admin/enquiries/bulk" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p style="margin-bottom:0.85rem;display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center">
      <label class="checkbox-label" style="margin:0">
        <input type="checkbox" id="selectAll" aria-label="Select all">
        <span>Select all</span>
      </label>
      <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete selected enquiries?');">Delete selected</button>
    </p>
  </form>

    <div class="admin-list" style="display:grid">
      <% enquiries.forEach(function(e){ %>
      <div class="admin-row">
        <label class="checkbox-label" style="margin:0">
          <input form="bulkForm" type="checkbox" name="ids" value="<%= e.id %>" class="row-check">
          <span class="admin-row-title"><%= e.name %></span>
        </label>
        <div class="admin-row-meta">
          <a href="tel:<%= e.phone %>"><%= e.phone %></a>
          <% var digits = waDigits(e.phone); if (digits) { %>
          · <a href="https://wa.me/<%= digits %>" target="_blank" rel="noopener">WhatsApp</a>
          <% } %>
          <% if (e.email) { %><br><%= e.email %><% } %>
          <% if (e.product) { %><br><%= e.product %><% } %>
          <br><%= (e.status || 'new') %> · <%= e.created_at %>
        </div>
        <% if (e.message) { %><p class="msg-cell" style="margin:0;color:var(--muted);font-size:0.9rem"><%= e.message %></p><% } %>
        <form action="/admin/enquiries/<%= e.id %>/status" method="POST" class="admin-form" style="margin:0">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="status_filter" value="<%= status || '' %>">
          <label>Status
            <select name="status">
              <% statuses.forEach(function(s){ %>
              <option value="<%= s %>" <%= (e.status || 'new')===s?'selected':'' %>><%= s %></option>
              <% }); %>
            </select>
          </label>
          <label>Note
            <textarea name="note" rows="2" placeholder="What was quoted, or when you called"><%= e.note||'' %></textarea>
          </label>
          <button type="submit" class="btn btn-amber btn-sm">Save</button>
        </form>
        <div class="admin-row-actions">
          <form action="/admin/enquiries/<%= e.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this enquiry?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
          </form>
        </div>
      </div>
      <% }); %>
    </div>
  <script>
    var selectAll = document.getElementById('selectAll');
    if (selectAll) {
      selectAll.addEventListener('change', function () {
        document.querySelectorAll('.row-check').forEach(function (c) { c.checked = selectAll.checked; });
      });
    }
  </script>
  <% } else { %><p class="empty-state">No enquiries yet.</p><% } %>
</main>
<%- include('_foot') %>
