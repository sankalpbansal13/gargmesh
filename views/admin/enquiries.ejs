<%- include('_head') %>
<%- include('_nav', { adminPage: 'enquiries' }) %>
<main class="admin-main">
  <h1>Enquiries</h1>
  <% if (typeof flash !== 'undefined' && flash) { %><p class="form-success"><%= flash %></p><% } %>
  <div class="admin-toolbar">
    <a href="/admin/enquiries.csv" class="btn btn-ghost btn-sm">Export CSV</a>
  </div>
  <% if (enquiries.length) { %>
  <form id="bulkForm" action="/admin/enquiries/bulk" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p style="margin-bottom:0.85rem;display:flex;flex-wrap:wrap;gap:0.5rem;align-items:center">
      <label class="checkbox-label" style="margin:0">
        <input type="checkbox" id="selectAll" aria-label="Select all">
        <span>Select all</span>
      </label>
      <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete selected enquiries?');">Delete selected</button>
    </p>

    <div class="admin-list" style="display:grid">
      <% enquiries.forEach(function(e){ %>
      <div class="admin-row">
        <label class="checkbox-label" style="margin:0">
          <input type="checkbox" name="ids" value="<%= e.id %>" class="row-check">
          <span class="admin-row-title"><%= e.name %></span>
        </label>
        <div class="admin-row-meta">
          <a href="tel:<%= e.phone %>"><%= e.phone %></a>
          · <a href="https://wa.me/91<%= (e.phone||'').replace(/\D/g,'').replace(/^91/,'') %>" target="_blank" rel="noopener">WhatsApp</a>
          <% if (e.email) { %><br><%= e.email %><% } %>
          <% if (e.product) { %><br><%= e.product %><% } %>
          <br><%= e.created_at %>
        </div>
        <% if (e.message) { %><p class="msg-cell" style="margin:0;color:var(--muted);font-size:0.9rem"><%= e.message %></p><% } %>
        <div class="admin-row-actions">
          <button type="submit" class="btn btn-danger btn-sm" formaction="/admin/enquiries/<%= e.id %>?_method=DELETE" formmethod="post" onclick="return confirm('Delete this enquiry?');">Delete</button>
        </div>
      </div>
      <% }); %>
    </div>
  </form>
  <script>
    var selectAll = document.getElementById('selectAll');
    if (selectAll) {
      selectAll.addEventListener('change', function () {
        document.querySelectorAll('.row-check').forEach(function (c) { c.checked = selectAll.checked; });
      });
    }
  </script>
  <% } else { %><p class="empty-state">No enquiries yet.</p><% } %>
</main>
<%- include('_foot') %>
