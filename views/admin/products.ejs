<%- include('_head') %>
<%- include('_nav', { adminPage: 'products' }) %>
<main class="admin-main">
  <h1>Products</h1>
  <% if (typeof flash !== 'undefined' && flash) { %><p class="form-success"><%= flash %></p><% } %>
  <div class="admin-toolbar">
    <a href="/admin/products/new" class="btn btn-amber btn-sm">+ Add product</a>
    <% if (showDeleted) { %>
    <a href="/admin/products" class="btn btn-ghost btn-sm">View live products</a>
    <% } else { %>
    <a href="/admin/products?deleted=1" class="btn btn-ghost btn-sm">View deleted</a>
    <% } %>
  </div>
  <form class="admin-filters" method="GET" action="/admin/products">
    <input type="hidden" name="deleted" value="<%= showDeleted?'1':'' %>">
    <label>Search
      <input type="search" name="q" value="<%= q||'' %>" placeholder="Product name…">
    </label>
    <label>Category
      <select name="category">
        <option value="">All categories</option>
        <% categories.forEach(function(c){ %><option value="<%= c %>" <%= cat===c?'selected':'' %>><%= c %></option><% }); %>
      </select>
    </label>
    <button type="submit" class="btn btn-ghost btn-sm">Filter</button>
    <a href="/admin/products" class="btn btn-ghost btn-sm">Clear</a>
  </form>

  <div class="admin-list" style="display:grid">
    <% products.forEach(function(p){ %>
    <div class="admin-row">
      <div>
        <div class="admin-row-title">
          <% if (p.deleted) { %>
          <%= p.name %> <span class="cover-badge">Deleted</span>
          <% } else { %>
          <a href="/products/<%= p.slug %>" target="_blank" rel="noopener"><%= p.name %></a>
          <% } %>
          <% if (p.featured) { %> ★<% } %>
        </div>
        <div class="admin-row-meta"><%= p.category || '—' %></div>
      </div>
      <form action="/admin/products/<%= p.id %>/price" method="POST" class="price-quick-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="redirect" value="/admin/products<%= showDeleted?'?deleted=1':'' %><%= q ? (showDeleted?'&':'?')+'q='+encodeURIComponent(q) : '' %>">
        <input type="text" name="price_from" value="<%= p.price_from||'' %>" placeholder="e.g. ₹120/sqft" aria-label="Price for <%= p.name %>" class="price-quick-input">
        <button type="submit" class="btn btn-amber btn-sm">Save</button>
      </form>
      <div class="admin-row-actions">
        <a href="/admin/products/<%= p.id %>/edit" class="btn btn-ghost btn-sm">Edit</a>
        <form action="/admin/products/<%= p.id %>/duplicate" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-ghost btn-sm">Duplicate</button>
        </form>
        <% if (!p.deleted) { %>
        <form action="/admin/products/<%= p.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Move this product to deleted?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger btn-sm">Delete</button>
        </form>
        <% } else { %>
        <form action="/admin/products/<%= p.id %>/restore" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-ghost btn-sm">Restore</button>
        </form>
        <form action="/admin/products/<%= p.id %>/permdelete" method="POST" onsubmit="return confirm('PERMANENTLY delete this product and its photos?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-danger btn-sm">Permanent</button>
        </form>
        <% } %>
      </div>
    </div>
    <% }); %>
    <% if (!products.length) { %><p class="empty-state">No products found.</p><% } %>
  </div>
</main>
<%- include('_foot') %>
