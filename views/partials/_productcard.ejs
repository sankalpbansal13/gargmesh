<% const catSlug = product.category_slug || 'perforated-sheets'; %>
<% const href = '/products/' + catSlug + '/' + (product.slug || slugify(product.name)); %>
<article class="product-card reveal">
  <a href="<%= href %>" class="pc-media">
    <% if (product.image) { %>
      <img src="<%= product.image %>" alt="<%= product.name %> in Noida — Garg Industrial Mesh" loading="lazy" width="600" height="450">
    <% } else { %>
      <div class="pc-empty" aria-label="No photo available">
        <span class="pc-empty-text"><%= product.name %></span>
      </div>
    <% } %>
  </a>
  <div class="pc-body">
    <% if (product.category_name || product.hole_shape) { %><span class="pc-cat"><%= product.category_name || (product.hole_shape + ' · ' + product.angle_deg + '°') %></span><% } %>
    <h3 class="pc-title"><a href="<%= href %>"><%= product.name %></a></h3>
    <p class="pc-spec"><%= product.short_desc %></p>
    <div class="pc-actions">
      <a href="<%= href %>" class="btn btn-amber btn-sm">View &amp; choose material</a>
      <a href="<%= waLink(product.name) %>" class="btn btn-wa btn-sm" target="_blank" rel="noopener" aria-label="WhatsApp about <%= product.name %>" data-ga="whatsapp">
        <%- include('_icon', {name:'whatsapp', size:14}) %> WhatsApp
      </a>
    </div>
  </div>
</article>
