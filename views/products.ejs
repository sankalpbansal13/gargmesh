<% const meta_description = "Step 1: choose your sheet type — perforated sheets and more from Garg Industrial Mesh, Noida."; %>
<%- include('partials/_head', { meta_description: meta_description }) %>
<%- include('partials/_header') %>

<section class="wiz-page">
  <div class="container">
    <%- include('partials/_wizard', { wizardStep: 1 }) %>
    <header class="wiz-head">
      <p class="wiz-kicker">Step 1 of 3</p>
      <h1>Choose sheet type</h1>
      <p class="wiz-help">Pick the kind of sheet you need. Next you’ll choose the hole pattern, then the metal.</p>
    </header>

    <div class="wiz-grid">
      <% if (!categories.length) { %>
        <p class="wiz-help">Catalogue updating — call <%= site.phone %> for a quote.</p>
      <% } %>
      <% categories.forEach(function(c){ %>
      <a href="/products/<%= c.slug %>" class="wiz-card">
        <div class="wiz-card-media">
          <% if (c.image) { %>
            <img src="<%= c.image %>" alt="" width="480" height="360" loading="lazy">
          <% } else { %>
            <span class="wiz-card-fallback"><%= c.name %></span>
          <% } %>
        </div>
        <div class="wiz-card-body">
          <h2>
            <%= c.name %>
            <span class="pill pill-count"><%= c.design_count || 0 %> designs</span>
          </h2>
          <% if (c.materials && c.materials.length) { %>
          <div class="wiz-mat-block">
            <p class="wiz-mat-label">Material types</p>
            <ul class="pill-row" aria-label="Material types">
              <% c.materials.forEach(function(m){ %>
              <li class="pill pill-mat"><%= m.name %></li>
              <% }); %>
            </ul>
          </div>
          <% } %>
          <span class="wiz-card-cta">Select →</span>
        </div>
      </a>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/_stickybar') %>
<%- include('partials/_footer') %>
