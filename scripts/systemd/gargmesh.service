[Unit]
Description=Garg Industrial Mesh website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/garg_industrial
EnvironmentFile=/home/ubuntu/garg_industrial/.env.prod
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/garg_industrial/data /home/ubuntu/garg_industrial/public/uploads /home/ubuntu/garg_industrial/logs
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
